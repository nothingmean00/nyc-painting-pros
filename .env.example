# Estimate form delivery (POST /api/estimate)
# Copy this file to .env.local and fill in real values.

# Get a free key at https://resend.com (required to actually send lead emails).
RESEND_API_KEY=

# Optional comma-separated extra recipients. Estimate requests always go to
# hello@nycpaintingpros.com and abielsoares@nycpaintingpros.com.
ESTIMATE_TO_EMAIL=

# Verified Resend sender. For quick testing you can use onboarding@resend.dev;
# for production, verify your domain in Resend and use e.g. estimates@nycpaintingpros.com
ESTIMATE_FROM_EMAIL=onboarding@resend.dev

# Durable intake and call-click storage. Provision Neon from the Vercel Marketplace; its
# integration supplies DATABASE_URL automatically.
DATABASE_URL=

# Optional local-only call log for previewing without production credentials.
# Leave unset on Vercel; production always uses DATABASE_URL.
# CALL_CLICK_PREVIEW_STORE=.local/call-clicks

# Single-admin portal credentials for /admin. Use a unique password and a
# randomly generated session secret of at least 32 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional Vercel AI Gateway model override for the Painting Project Assistant.
AI_CHAT_MODEL=inclusionai/ling-3.0-flash-free

# Private lead dashboard email. Turn AI on after a test thread works in both directions.
LEAD_AI_ENABLED=false
LEAD_AI_MODEL=gpt-6.2-sol
# Server-side OpenAI project key for direct lead email and estimating calls.
LEAD_OPENAI_API_KEY=
# Optional gateway credentials for the public chat assistant, which also supports Vercel OIDC.
# AI_GATEWAY_API_KEY=
# Dedicated Resend receiving domain or account-specific .resend.app subdomain.
LEAD_REPLY_DOMAIN=
# Optional private address on LEAD_REPLY_DOMAIN for a copy of hello@ incoming mail.
LEAD_INTAKE_ADDRESS=
# Set only if the verified Resend signed attachment URLs use another exact host.
# LEAD_RESEND_ATTACHMENT_HOST=
LEAD_RESEND_WEBHOOK_SECRET=
# Optional separate full-access Resend key for inbox and sent-message reads.
# RESEND_RECEIVING_API_KEY=
CRON_SECRET=

# Optional automatic PDF estimates for the documented small-room package.
LEAD_AUTO_QUOTE_ENABLED=false
# Published comparable midpoint before the 10% discount, in cents.
LEAD_AUTO_QUOTE_MARKET_CENTS=54750
# "additional" adds applicable tax at invoicing. "included" treats the estimate as tax-inclusive.
LEAD_AUTO_QUOTE_TAX=additional
