# Estimate form delivery (POST /api/estimate)
# Copy this file to .env.local and fill in real values.

# Get a free key at https://resend.com (required to actually send lead emails).
RESEND_API_KEY=

# Optional comma-separated extra recipients. Estimate requests always go to
# hello@nycpaintingpros.com and abielsoares@nycpaintingpros.com.
ESTIMATE_TO_EMAIL=

# Verified Resend sender. For quick testing you can use onboarding@resend.dev;
# for production, verify your domain in Resend and use e.g. estimates@nycpaintingpros.com
ESTIMATE_FROM_EMAIL=onboarding@resend.dev

# Durable intake storage. Provision Neon from the Vercel Marketplace; its
# integration supplies DATABASE_URL automatically.
DATABASE_URL=

# Single-admin portal credentials for /admin. Use a unique password and a
# randomly generated session secret of at least 32 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional Vercel AI Gateway model override for the Painting Project Assistant.
AI_CHAT_MODEL=inclusionai/ling-3.0-flash-free
